diff --git a/plugins/platforms/telegram/adapter.py b/plugins/platforms/telegram/adapter.py
index 11259b6db0..d9633164cd 100644
--- a/plugins/platforms/telegram/adapter.py
+++ b/plugins/platforms/telegram/adapter.py
@@ -10531,6 +10531,45 @@ class TelegramAdapter(BasePlatformAdapter):
         except Exception:
             return None
 
+    @staticmethod
+    def _slice_telegram_utf16(text: str, offset: int, length: int) -> str:
+        """Return a Telegram entity span whose offsets are UTF-16 code units."""
+        start = max(0, int(offset))
+        end = start + max(0, int(length))
+        units = 0
+        selected: list[str] = []
+        for char in text:
+            next_units = units + (2 if ord(char) > 0xFFFF else 1)
+            if next_units > start and units < end:
+                selected.append(char)
+            if units >= end:
+                break
+            units = next_units
+        return "".join(selected)
+
+    @classmethod
+    def _append_text_link_urls(cls, message: Message, text: str) -> str:
+        """Expose URLs hidden behind inbound Telegram ``text_link`` entities."""
+        links: list[tuple[str, str]] = []
+        seen: set[tuple[str, str]] = set()
+        for entity in getattr(message, "entities", None) or ():
+            if not str(getattr(entity, "type", "")).lower().endswith("text_link"):
+                continue
+            url = getattr(entity, "url", None)
+            if not isinstance(url, str) or not url:
+                continue
+            label = cls._slice_telegram_utf16(
+                text, getattr(entity, "offset", 0), getattr(entity, "length", 0)
+            ).strip()
+            pair = (label or "Ссылка", url)
+            if pair not in seen:
+                seen.add(pair)
+                links.append(pair)
+        if not links:
+            return text
+        rendered_links = "\n".join(f"- {label}: {url}" for label, url in links)
+        return f"{text}\n\nСсылки из исходного сообщения:\n{rendered_links}"
+
